repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
framework=${YURUNA_FRAMEWORK_ROOT:-$repo_root/../yuruna}
# --- REGION: run_metadata_gate
# The framework's source-metadata gate holds the staged files to the header
# contract: the license pointer, the copyright line and a unique 42-prefixed
# GUID (the framework's CONTRIBUTING.md, "Source metadata"). It runs from the
# framework checkout beside this repository, or where YURUNA_FRAMEWORK_ROOT
# points; without that checkout or pwsh the check is skipped with a warning.
run_metadata_gate() {
    metadata_gate="$framework/tools/Test-SourceMetadata.ps1"
    if [ ! -f "$metadata_gate" ] || ! command -v pwsh >/dev/null 2>&1; then
        echo 'pre-commit: WARNING: the source-metadata check did not run; it needs pwsh and the framework checkout beside this repository (or YURUNA_FRAMEWORK_ROOT).' >&2
        return 0
    fi
    if ! NO_COLOR=1 pwsh -NoProfile -ExecutionPolicy Bypass -File "$metadata_gate" -Staged -Quiet -Root "$repo_root" >&2; then
        echo 'pre-commit: the source-metadata gate failed (see above); the commit is blocked.' >&2
        echo "  Add the lines it shows, or declare a generated or vendored path in the framework's" >&2
        echo '  tools/source-metadata.exemptions.json. git commit --no-verify skips the check (discouraged).' >&2
        return 1
    fi
}
# --- REGION: SBOM
# See https://yuruna.link/427fb0be
run_sbom() {
    sbom_generator="$repo_root/tools/Sync-Sbom.py"
    if [ ! -f "$sbom_generator" ]; then
        echo 'pre-commit: SBOM generator is missing: tools/Sync-Sbom.py.' >&2
        return 1
    fi
    sbom_python=''
    for sbom_candidate in python3 python; do
        if command -v "$sbom_candidate" >/dev/null 2>&1 &&
            "$sbom_candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
            sbom_python=$sbom_candidate
            break
        fi
    done
    if [ -z "$sbom_python" ]; then
        echo 'pre-commit: Python 3.11 or newer is required to refresh and stage SBOMs.' >&2
        return 1
    fi
    if ! "$sbom_python" "$sbom_generator" --staged --stage; then
        echo 'pre-commit: SBOM refresh failed; the commit is blocked.' >&2
        return 1
    fi
}
run_metadata_gate || exit 1
run_sbom || exit 1
exit 0
