# The Yuruna runner checks this repo out on a Windows host and serves it to
# Linux guests (checkout AND git-archive tarball). Everything a guest consumes
# must stay LF regardless of core.autocrlf.
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.rs    text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf
*.bazel text eol=lf
*.dart  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
Dockerfile    text eol=lf
.bazelversion text eol=lf
.bazelrc      text eol=lf
.dockerignore text eol=lf
.gitignore    text eol=lf

# PowerShell driving the build and the Yuruna resource steps. pwsh handles
# either EOL, but these are edited on Windows and macOS workstations and run
# from a Windows checkout, so pin LF to stop the round-trip CRLF<->LF churn
# from showing up as whole-file diffs.
*.ps1   text eol=lf
*.psm1  text eol=lf
*.psd1  text eol=lf

*.svg   text eol=lf
*.txt   text eol=lf
*.lock  text eol=lf
*.proto text eol=lf
LICENSE text eol=lf
# Read verbatim and used as a version string.
VERSION text eol=lf
.gitattributes text eol=lf

# Binaries -- never normalize, so git cannot misclassify them as text and
# rewrite bytes inside them.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.exe   binary
