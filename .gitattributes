# The Yuruna runner checks this repo out on a Windows host and serves it to
# Linux guests (checkout AND git-archive tarball). Everything a guest consumes
# must stay LF regardless of core.autocrlf.
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.rs    text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf
*.bazel text eol=lf
*.dart  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
Dockerfile    text eol=lf
.bazelversion text eol=lf
.bazelrc      text eol=lf
.dockerignore text eol=lf
.gitignore    text eol=lf
