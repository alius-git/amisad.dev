"""AmisAd POC Bazel module.

Rust builds through rules_rust with a pinned toolchain. Third-party crates
resolve through crate_universe from the committed Cargo.lock - wired together
with the first external dependency (postgres), as poc/README.md planned.
"""

module(
    name = "amisad_poc",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.71.3")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    # Lockstep with the Dockerfiles + Cargo MSRV. Capped at the newest Rust
    # rules_rust ships a checksum for (0.71.3 tops out at 1.96.1).
    versions = ["1.96.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//components/lib/amisad-common:Cargo.toml",
        "//components/services/ads-svc:Cargo.toml",
        "//components/services/audit-svc:Cargo.toml",
        "//components/services/connect-svc:Cargo.toml",
        "//components/services/fabric-coordinator:Cargo.toml",
        "//components/services/identity-mock:Cargo.toml",
        "//components/services/insights-svc:Cargo.toml",
        "//components/services/ledger-svc:Cargo.toml",
        "//components/services/platform-svc:Cargo.toml",
        "//components/services/resource-svc:Cargo.toml",
        "//components/services/seller-svc:Cargo.toml",
        "//components/edge/slice-runtime:Cargo.toml",
        "//components/apps/buyer-client:Cargo.toml",
    ],
)
use_repo(crate, "crates")
